RECORDER_PROAVALON_USERNAME=
RECORDER_PROAVALON_PASSWORD=
RECORDER_INSTANCE_ID=recorder-1
# Keep 0 for the primary. Use 3 for a secondary worker so the primary claims first.
RECORDER_CLAIM_DELAY_SECONDS=0
# Optional emergency fallback. Normally read dynamically from Pbot.
RECORDER_SEASON_PREFIX=
RECORDER_BRIDGE_URL=https://your-pbot.up.railway.app
RECORDER_BRIDGE_SECRET=
DISCORD_GUILD_ID=
CRAIG_CONTROL_URL=http://craig.railway.internal:9300
CRAIG_CONTROL_TOKEN=
CRAIG_DOWNLOAD_URL=http://craig.railway.internal:9100
CRAIG_DATA_DIR=/data/craig
VIDEO_OUTPUT_DIR=/data/browser
AUDIO_OUTPUT_DIR=/data/audio
FINAL_OUTPUT_DIR=/data/final
# Unreferenced failed/cancelled artifacts are removed after this many hours.
RECORDER_ORPHAN_RETENTION_HOURS=24
RECORDER_AUDIO_SYNC_CORRECTION_SECONDS=2.0
