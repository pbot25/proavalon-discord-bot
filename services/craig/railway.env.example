# Database and Redis service references (replace service names if yours differ).
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_HOST=${{Redis.RAILWAY_PRIVATE_DOMAIN}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
REDIS_DATABASE=0
REDIS_PREFIX=proavalon-craig:

# Existing dedicated Discord recorder application.
BOT_TOKEN=YOUR_DISCORD_RECORDER_BOT_TOKEN
BOT_APPLICATION_ID=YOUR_DISCORD_RECORDER_APPLICATION_ID
PUBLIC_DISCORD_CLIENT_ID=YOUR_DISCORD_RECORDER_APPLICATION_ID
DEVELOPMENT_GUILD_ID=YOUR_DISCORD_GUILD_ID

# Private controller endpoint used only by recorder-worker.
BOT_CONTROL_HOST=0.0.0.0
BOT_CONTROL_PORT=9300
BOT_CONTROL_TOKEN=USE_THE_SAME_SECRET_AS_RECORDER_WORKER
BOT_CONTROL_ALLOW_EVAL=false

# Persistent recording paths.
REC_DIRECTORY=/data/rec
DOWNLOADS_DIRECTORY=/data/downloads
OUTPUT_DIRECTORY=/data/output
TMP_DIRECTORY=/tmp/craig

# Minimal production settings.
NODE_ENV=production
LOGGER_LEVEL=info
BOT_STATUS_TEXT=Recording ProAvalon matches
WEBAPP_ENABLED=false
CRAIG_STARTUP_TIMEOUT=120

